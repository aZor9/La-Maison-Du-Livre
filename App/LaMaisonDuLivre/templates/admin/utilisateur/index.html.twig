{% extends 'base.html.twig' %}

{% block title %}Listing des Utilisateurs{% endblock %}

{% block body %}
{% include 'partie/navbar.html.twig' %}

<div class="container mx-auto py-10 max-w-6xl">
    <h2 class="text-3xl font-bold mb-6 text-center text-blue-700">Liste des utilisateurs</h2>

    <!-- Barre de recherche -->
    <form method="get" action="{{ path('utilisateur_index') }}" class="mb-6">
        <div class="flex flex-wrap gap-4 justify-center">
            <input 
                type="text" 
                name="search" 
                class="form-input w-full md:w-1/2 py-2 px-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" 
                placeholder="Rechercher par email" 
                value="{{ search }}"
            >
            <button 
                type="submit" 
                class="bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
                Rechercher
            </button>
        </div>
    </form>

    <!-- Table des utilisateurs -->
    <div class="overflow-x-auto shadow-lg rounded-lg">
        <table class="table-auto w-full text-left border border-gray-200">
            <thead class="bg-blue-100 text-blue-700">
                <tr>
                    <th class="py-3 px-6">Nom</th>
                    <th class="py-3 px-6">Prénom</th>
                    <th class="py-3 px-6">Email</th>
                    <th class="py-3 px-6">Rôle</th>
                    <th class="py-3 px-6">Abonnement</th>
                    <th class="py-3 px-6 text-center">Voir</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                {% for utilisateur in utilisateurs %}
                    <tr class="border-b hover:bg-blue-50">
                        <td class="py-3 px-6">{{ utilisateur.nom }}</td>
                        <td class="py-3 px-6">{{ utilisateur.prenom }}</td>
                        <td class="py-3 px-6">{{ utilisateur.mail }}</td>
                        <td class="py-3 px-6">
                            {% for role in utilisateur.roles %}
                                <span>{{ role }}</span>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </td>
                        <td class="py-3 px-6">
                            {% if utilisateur.abonnement is not null %}
                                <span class="{% if utilisateur.abonnement.isNearExpiration() %}text-red-600{% else %}text-gray-700{% endif %}">
                                    {{ utilisateur.abonnement.statutAbonnement }}
                                </span>
                            {% else %}
                                Aucun abonnement
                            {% endif %}
                        </td>
                        <td class="py-3 px-6 text-center">
                            <a href="{{ path('utilisateur_show', {'id': utilisateur.idutilisateur}) }}" class="text-blue-600 hover:underline">Voir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="py-3 px-6 text-center text-gray-500">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% include 'partie/footer.html.twig' %}
{% endblock %}