{% extends 'base.html.twig' %}

{% block title %}Gestion des auteurs{% endblock %}

{% block body %}
    <!-- Navbar -->
    {% include 'partie/navbar.html.twig' %}
    <div class="py-8">
        <div class="container mx-auto px-4">
            <h1 class="text-3xl font-semibold text-blue-700 mb-6">Gestion des créateurs de contenus</h1>

            <!-- Barre de recherche -->
            <form method="get" action="{{ path('admin_auteurs') }}" class="mb-6">
                <div class="flex gap-4">
                    <input type="text" name="search" class="form-input w-full py-2 px-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Rechercher un auteur" value="{{ search }}">
                    <button type="submit" class="bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-700">Rechercher</button>
                </div>
            </form>

            <!-- Liste des auteurs -->
            <div class="overflow-x-auto shadow-lg rounded-lg mb-6">
                <table class="table-auto w-full text-left">
                    <thead class="bg-blue-100 text-blue-700">
                        <tr>
                            <th class="py-3 px-6">ID</th>
                            <th class="py-3 px-6">Prénom</th>
                            <th class="py-3 px-6">Nom</th>
                            <th class="py-3 px-6">Description</th>
                            <th class="py-3 px-6 text-center">Actions</th> {# Nouvelle colonne pour les actions #}
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        {% for auteur in auteurs %}
                            <tr class="border-b hover:bg-blue-50">
                                <td class="py-3 px-6">{{ auteur.idAuteur }}</td>
                                <td class="py-3 px-6">{{ auteur.prenom }}</td>
                                <td class="py-3 px-6">{{ auteur.nom }}</td>
                                <td class="py-3 px-6">{{ auteur.description ?: 'N/A' }}</td>
                                <td class="py-3 px-6 text-center">
                                    <form method="post" action="{{ path('admin_auteurs_delete', { id: auteur.idAuteur }) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet auteur ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ auteur.idAuteur) }}">
                                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-sm font-semibold py-1 px-3 rounded-lg">
                                            🗑️ Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="py-3 px-6 text-center text-gray-500">Aucun auteur trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Formulaire de création -->
            <div class="bg-white shadow-lg rounded-lg p-6">
                <h2 class="text-2xl font-semibold text-blue-700 mb-4">Créer un nouvel auteur</h2>
                {{ form_start(form) }}
                    <div class="space-y-4">
                        {{ form_row(form.prenom) }}
                        {{ form_row(form.nom) }}
                        {{ form_row(form.description) }}
                    </div>
                    <div class="mt-4">
                        {{ form_row(form.save) }}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    
        {% include 'partie/footer.html.twig' %}
{% endblock %}