{% extends 'base.html.twig' %}

{% block title %}Mes emprunts{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}

    <div class="py-8">
        <div class="container mx-auto px-4">
            <h1 class="text-3xl font-semibold text-blue-700 mb-6">Mes emprunts</h1>

            <div class="overflow-x-auto shadow-lg rounded-lg">
                <table class="table-auto w-full text-left">
                    <thead class="bg-blue-100 text-blue-700">
                        <tr>
                            <th class="py-3 px-6">ID</th>
                            <th class="py-3 px-6">Titre</th>
                            <th class="py-3 px-6">Auteur(s)</th>
                            <th class="py-3 px-6">Année</th>
                            <th class="py-3 px-6">Thème</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        {% for item in documentsAvecAuteurs %}
                            {% set document = item.document %}
                            {% set auteurs = item.auteurs %}
                            <tr class="border-b hover:bg-blue-50">
                                <td class="py-3 px-6">{{ document.idDocument }}</td>
                                <td class="py-3 px-6">{{ document.Titre }}</td>
                                <td class="py-3 px-6">
                                    <ul class="space-y-1 text-gray-600">
                                        {% for auteur in auteurs %}
                                            <li>{{ auteur.prenom }} {{ auteur.nom }}</li>
                                        {% else %}
                                            <li>Aucun auteur associé.</li>
                                        {% endfor %}
                                    </ul>
                                </td>
                                <td class="py-3 px-6">{{ document.Annee ? document.Annee|date('Y') : 'N/A' }}</td>
                                <td class="py-3 px-6">{{ document.theme }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="py-3 px-6 text-center text-gray-500">Aucun emprunt trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 my-4">
        <div class="flex items-center p-4 mb-4 text-sm text-yellow-700 border border-yellow-500 rounded-lg bg-white" role="alert">
            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="sr-only">Info</span>
            <div>
                <p> En cas de problème, pour delarer l'état d'un livre, veuillez contacter le service client ou vous rendre sur place</p>
            </div>
        </div>
    </div>

    {% include 'partie/footer.html.twig' %}
{% endblock %}