{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau document{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}
    <div class="py-8 bg-gray-100 min-h-screen">
        <div class="container mx-auto px-4">
            <h1 class="text-3xl font-bold text-blue-700 mb-6">Créer un nouveau document</h1>

            <div class="bg-white shadow-md rounded-lg p-6">
                {{ form_start(form, { 'attr': { 'class': 'space-y-6' } }) }}
                    <div class="grid grid-cols-1 gap-6">
                        {{ form_row(form.titre, { 
                            'label_attr': { 'class': 'font-medium text-gray-700' }, 
                            'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                        }) }}
                        
                        {{ form_row(form.annee, { 
                            'label_attr': { 'class': 'font-medium text-gray-700' }, 
                            'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                        }) }}
                        
                        {{ form_row(form.theme, { 
                            'label_attr': { 'class': 'font-medium text-gray-700' }, 
                            'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                        }) }}
                        
                        {{ form_row(form.type, { 
                            'label_attr': { 'class': 'font-medium text-gray-700' }, 
                            'attr': { 'class': 'space-y-2' } 
                        }) }}

                        <div>
                            <label class="font-medium text-gray-700 block mb-2">Auteurs</label>
                            <div class="space-y-2">
                                {% for checkbox in form.auteurs %}
                                    <div class="flex items-center">
                                        {{ form_widget(checkbox, { 'attr': { 'class': 'h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded' } }) }}
                                        <label class="ml-2 text-gray-700" for="{{ checkbox.vars.id }}">{{ checkbox.vars.label }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.auteurs, { 'attr': { 'class': 'mt-2 text-sm text-red-600' } }) }}
                        </div>

                        {% if document.type == 'Livre' %}                
                            {{ form_row(form.isbn, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.nombrePage, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.genre, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}
                        {% elseif document.type == 'Video' %}
                            {{ form_row(form.duree, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.format, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.realisateur, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}
                        {% elseif document.type == 'Sonore' %}
                            {{ form_row(form.duree, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.format, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.interprete, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}
                        {% elseif document.type == 'Titreperiodique' %}
                            {{ form_row(form.numero, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.datepublication, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}

                            {{ form_row(form.format, { 
                                'label_attr': { 'class': 'font-medium text-gray-700' }, 
                                'attr': { 'class': 'w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500' } 
                            }) }}
                        {% endif %}

                    </div>

                    <div class="mt-6">
                        {{ form_row(form.submit, { 
                            'attr': { 'class': 'w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300' } 
                        }) }}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    {% include 'partie/footer.html.twig' %}
{% endblock %}