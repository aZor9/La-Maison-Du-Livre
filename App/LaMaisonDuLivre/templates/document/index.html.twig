{% extends 'base.html.twig' %}

{% block title %}Liste des documents{% endblock %}

{% block body %}
    <!-- Navbar -->
    {% include 'partie/navbar.html.twig' %}

    <div class="py-8">
        <div class="container mx-auto px-4">
            <h1 class="text-3xl font-semibold text-blue-700 mb-6">Liste des documents</h1>

            <!-- Formulaire de recherche -->
            <form method="get" action="{{ path('app_documents') }}" class="mb-6">
                <div class="flex gap-4">
                    <input type="text" name="search" class="form-input w-full py-2 px-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Rechercher un document" value="{{ search }}">
                    <button type="submit" class="bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-700">Rechercher</button>
                </div>
            </form>

            <!-- Table -->
            <div class="overflow-x-auto shadow-lg rounded-lg">
                <table class="table-auto w-full text-left">
                    <thead class="bg-blue-100 text-blue-700">
                        <tr>
                            <th class="py-3 px-6">ID</th>
                            <th class="py-3 px-6">Titre</th>
                            <th class="py-3 px-6">Auteur(s)</th>
                            <th class="py-3 px-6">Type</th>
                            <th class="py-3 px-6">Année</th>
                            <th class="py-3 px-6">Thème</th>
                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                <th class="py-3 px-6 text-center">Actions</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        {% for item in documentsAvecAuteurs %}
                            {% set document = item.document %}
                            {% set auteurs = item.auteurs %}
                            <tr class="border-b hover:bg-blue-50">
                                <td class="py-3 px-6">
                                    <a href="{{ path('document_show', {'id': document.idDocument}) }}" class="block w-full h-full">
                                        {{ document.idDocument }}
                                    </a>
                                </td>
                                <td class="py-3 px-6">
                                    <a href="{{ path('document_show', {'id': document.idDocument}) }}" class="block w-full h-full">
                                        {{ document.Titre }}
                                    </a>
                                </td>
                                <td class="py-3 px-6">
                                    <ul class="space-y-1 text-gray-600">
                                        {% for auteur in auteurs %}
                                                <li>
                                                    <span>{{ auteur.prenom }} {{ auteur.nom }}</span>
                                                </li>
                                        {% else %}
                                            <li>-</li>
                                        {% endfor %}
                                    </ul>
                                </td>
                                <td class="py-3 px-6">
                                    {{ document.type == 'titreperiodique' ? 'Titre périodique' : document.type }}
                                </td>
                                <td class="py-3 px-6">
                                    {{ document.Annee ? document.Annee|date('Y') : 'N/A' }}
                                </td>
                                <td class="py-3 px-6">
                                    {{ document.theme }}
                                </td>
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <td class="py-3 px-6 text-center">
                                        <form method="post" action="{{ path('document_delete', { id: document.idDocument }) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce document ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.idDocument) }}">
                                            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-1 px-3 rounded-lg">
                                                🗑️ Supprimer
                                            </button>
                                        </form>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="py-3 px-6 text-center text-gray-500">Aucun document trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    {% include 'partie/footer.html.twig' %}
{% endblock %}
