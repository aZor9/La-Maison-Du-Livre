{% extends 'base.html.twig' %}

{% block title %}Détails du document{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="bg-white shadow-xl rounded-2xl p-6">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">📘 Document n°{{ document.idDocument }}</h2>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">{{ document.titre }}</h3>

            <ul class="space-y-2 text-gray-600 mb-6">
                <li><span class="font-semibold">Année :</span> {{ document.annee ? document.annee|date('Y') : 'Non précisée' }}</li>
                <li><span class="font-semibold">theme :</span> {{ document.theme }}</li>
                <li><span class="font-semibold">Type :</span> {{ document.type == 'Titreperiodique' ? 'Titre Periodique' : document.type }}</li>
                <li><span class="font-semibold">Auteurs :</span> 
                    <ul class="space-y-1 text-gray-600">
                        {% for auteur in auteurs %}
                            <li>
                                <span> - {{ auteur.prenom }} {{ auteur.nom }}</span>
                            </li>
                        {% else %}
                            <li> Aucun auteur associé à ce document.</li>
                        {% endfor %}
                    </ul>
                </li>
            </ul>

            {% if document.type == 'Livre' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">📖 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">ISBN :</span> {{ document.isbn }}</li>
                    <li><span class="font-semibold">Nombre de pages :</span> {{ document.nombrePage }}</li>
                    <li><span class="font-semibold">Genre :</span> {{ document.genre }}</li>
                </ul>
            {% elseif document.type == 'Video' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">🎬 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">duree :</span> {{ document.duree }} min</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                    <li><span class="font-semibold">Réalisateur :</span> {{ document.realisateur }}</li>
                </ul>
            {% elseif document.type == 'Sonore' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">🎧 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">duree :</span> {{ document.duree }} sec</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                    <li><span class="font-semibold">Interprète :</span> {{ document.interprete }}</li>
                </ul>
            {% elseif document.type == 'Titreperiodique' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">📰 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">Numéro :</span> {{ document.numero }}</li>
                    <li><span class="font-semibold">Date de publication :</span> {{ document.datePublication|date('d/m/Y') }}</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                </ul>
            {% endif %}

            <div class="mt-6 text-center">
                {# <a href="#" class="bg-green-500 hover:bg-green-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">
                    🛒 Commander ce document
                </a> #}
                {% if exemplaires|filter(e => e.statut == 'disponible')|length > 0 %}
                    <form method="post" action="{{ path('document_reserver', {id: document.idDocument}) }}">
                        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">🛒 Commander ce document</button>
                    </form>
                {% else %}
                    <a href="#" class="bg-gray-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">Aucun exemplaire disponible</a>
                {% endif %}

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>


            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
                <div class="mt-4 text-center">
                    <a href="{{ path('document_edit', {'id': document.idDocument}) }}" class="bg-blue-500 hover:bg-blue-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">
                        ✏️ Modifier ce document
                    </a>
                </div>
            {% endif %}
        </div>
    </div>



{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
    <h2 class="text-2xl font-bold text-gray-800 m-3">Exemplaires disponibles</h2>
    <div class="flex justify-between items-center m-3">
        <div>
            <a href="{{ path('exemplaire_new', {'documentId': document.idDocument}) }}" 
               class="bg-green-500 hover:bg-green-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">
                ➕ Ajouter un exemplaire
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 m-3">
        {% for exemplaire in exemplaires %}
            <div class="bg-white shadow-md rounded-lg p-4 border border-gray-200">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Code : {{ exemplaire.idexemplaire }}</h3>
                <p class="text-sm text-gray-600 mb-1">
                    <strong>État :</strong> 
                    <span class="capitalize">{{ exemplaire.etatphysique }}</span>
                </p>
                <div class="mt-4">
                    {% if exemplaire.statut == 'disponible' %}
                        <span class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full">Disponible</span>
                    {% elseif exemplaire.statut == 'reserve' %}
                        <span class="inline-block bg-yellow-100 text-yellow-700 text-xs font-semibold px-3 py-1 rounded-full">Réservé</span>
                    {% elseif exemplaire.statut == 'utilise' %}
                        <span class="inline-block bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full">Utilisé</span>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <form method="post" action="{{ path('exemplaire_delete', {'id': exemplaire.idexemplaire}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exemplaire ?');">
                        <button type="submit" class="bg-red-400 hover:bg-red-600 text-white text-sm font-semibold py-2 px-4 rounded-md shadow-md transition duration-300">
                            🗑️ Supprimer
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center text-gray-500">
                Aucun exemplaire disponible pour ce document.
            </div>
        {% endfor %}
    </div>
{% endif %}

    {% include 'partie/footer.html.twig' %}
{% endblock %}
