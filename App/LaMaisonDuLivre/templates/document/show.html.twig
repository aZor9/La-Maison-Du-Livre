{% extends 'base.html.twig' %}

{% block title %}Détails du document{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}

    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="bg-white shadow-xl rounded-2xl p-6">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">📘 Document n°{{ document.idDocument }}</h2>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">{{ document.titre }}</h3>

            <ul class="space-y-2 text-gray-600 mb-6">
                <li><span class="font-semibold">Année :</span> {{ document.annee ? document.annee|date('Y') : 'Non précisée' }}</li>
                <li><span class="font-semibold">theme :</span> {{ document.theme }}</li>
                <li><span class="font-semibold">Type :</span> {{ document.type == 'Titreperiodique' ? 'Titre Periodique' : document.type }}</li>
            </ul>

            {% if document.type == 'Livre' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">📖 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">ISBN :</span> {{ document.isbn }}</li>
                    <li><span class="font-semibold">Nombre de pages :</span> {{ document.nombrePage }}</li>
                    <li><span class="font-semibold">Genre :</span> {{ document.genre }}</li>
                </ul>
            {% elseif document.type == 'Video' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">🎬 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">duree :</span> {{ document.duree }} min</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                    <li><span class="font-semibold">Réalisateur :</span> {{ document.realisateur }}</li>
                </ul>
            {% elseif document.type == 'Sonore' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">🎧 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">duree :</span> {{ document.duree }} sec</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                    <li><span class="font-semibold">Interprète :</span> {{ document.interprete }}</li>
                </ul>
            {% elseif document.type == 'Titreperiodique' %}
                <h4 class="text-lg font-semibold text-indigo-600 mb-2">📰 Informations</h4>
                <ul class="space-y-1 text-gray-600">
                    <li><span class="font-semibold">Numéro :</span> {{ document.numero }}</li>
                    <li><span class="font-semibold">Date de publication :</span> {{ document.datePublication|date('d/m/Y') }}</li>
                    <li><span class="font-semibold">Format :</span> {{ document.format }}</li>
                </ul>
            {% endif %}

            <div class="mt-6 text-center">
                <a href="#" class="bg-green-500 hover:bg-green-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">
                    🛒 Commander ce document
                </a>
            </div>

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
                <div class="mt-4 text-center">
                    <a href="{{ path('document_edit', {'id': document.idDocument}) }}" class="bg-blue-500 hover:bg-blue-600 text-white text-lg font-semibold py-2 px-6 rounded-xl shadow-md transition duration-300">
                        ✏️ Modifier ce document
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    {% include 'partie/footer.html.twig' %}
{% endblock %}
