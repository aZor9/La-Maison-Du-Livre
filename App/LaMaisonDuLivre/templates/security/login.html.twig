{% extends 'base.html.twig' %}

{% block title %}Se connecter à la Médiathèque Montpellier{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-card">
            <h1 class="login-title">Se connecter</h1>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Se déconnecter</a>
                    </div>
                {% endif %}

                <div class="form-group">
                    <label for="inputMail" class="form-label">Email</label>
                    <input type="email" name="Mail" id="inputMail" class="form-control" value="{{ last_username }}" autocomplete="username" required autofocus placeholder="Entrez votre email">
                </div>

                <div class="form-group">
                    <label for="inputPassword" class="form-label">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Entrez votre mot de passe">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-3">
                    <input type="checkbox" name="_remember_me" class="form-check-input" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
            </form>
        </div>
    </div>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f7f7;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: #333;
        }

        .login-container {
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .login-card {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .login-title {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: #0056b3;
        }

        .form-group {
            margin-bottom: 20px;
            width: 100%;
        }

        .form-label {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            background-color: #f9f9f9;
            color: #333;
        }

        .form-control:focus {
            border-color: #0056b3;
            outline: none;
            background-color: #fff;
        }

        .form-check-label {
            font-size: 0.9rem;
            color: #555;
        }

        .btn-primary {
            background-color: #0056b3;
            border-color: #0056b3;
            padding: 12px;
            font-size: 1rem;
            width: 100%;
            border-radius: 25px;
            color: #fff;
            transition: background-color 0.3s;
        }

        .btn-primary:hover {
            background-color: #00408f;
        }

        .alert {
            margin-bottom: 20px;
            font-size: 0.9rem;
            text-align: center;
            color: #ff4d4d;
        }

        .btn-block {
            display: block;
        }

        @media (max-width: 768px) {
            .login-container {
                padding: 20px;
            }
        }
    </style>
{% endblock %}
