{% extends 'base.html.twig' %}

{% block title %}Liste des Exemplaires{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}

    <div class="container mx-auto my-8 px-4">
        <h1 class="text-3xl font-semibold text-blue-700 mb-6">Liste des Exemplaires</h1>
        <div class="overflow-x-auto shadow-lg rounded-lg">
            <table class="min-w-full bg-white text-sm">
                <thead class="bg-blue-100 text-blue-700">
                    <tr class="text-center">
                        <th class="px-4 py-2 border">ID</th>
                        <th class="px-4 py-2 border">Document</th>
                        <th class="px-4 py-2 border">État physique</th>
                        <th class="px-4 py-2 border">Statut</th>
                        <th class="px-4 py-2 border">Réservé par</th>
                        <th class="px-4 py-2 border">Date réservation</th>
                        {# <th class="px-4 py-2 border">Date rendu</th> #}
                        <th class="px-4 py-2 border">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in exemplairesAvecInfos %}
                        {% set exemplaire = item.exemplaire %}
                        {% set emprunt = item.emprunt %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-2 border">{{ exemplaire.idexemplaire }}</td>
                            <td class="px-4 py-2 border">{{ exemplaire.document.titre }}</td>
                            <td class="px-4 py-2 border">{{ exemplaire.etatphysique }}</td>
                            <td class="px-4 py-2 border">{{ exemplaire.statut }}</td>
                            <td class="px-4 py-2 border">
                                {% if emprunt %}
                                    {{ emprunt.utilisateur.mail }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 border">
                                {% if emprunt %}
                                    {{ emprunt.dateReservation|date('d/m/Y') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            {# <td class="px-4 py-2 border">
                                {% if emprunt %}
                                    {% if emprunt.dateRendu %}
                                        {{ emprunt.dateRendu|date('d/m/Y') }}
                                    {% else %}
                                        Non rendu
                                    {% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td> #}
                            <td class="px-4 py-2 border">
                                {% if exemplaire.statut == 'disponible' %}
                                    <span class="text-green-600 font-semibold">Disponible</span>
                                {% elseif exemplaire.statut == 'reserve' %}
                                    <form method="post" action="{{ path('exemplaire_changer_statut', {id: exemplaire.idexemplaire}) }}">
                                        <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-xs">
                                            Marquer comme utilisé
                                        </button>
                                    </form>
                                {% elseif exemplaire.statut == 'utilise' %}
                                    <form method="post" action="{{ path('exemplaire_changer_statut', {id: exemplaire.idexemplaire}) }}">
                                        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-xs">
                                            Rendre disponible
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="px-4 py-2 text-center text-gray-500">Aucun exemplaire trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include 'partie/footer.html.twig' %}
{% endblock %}
