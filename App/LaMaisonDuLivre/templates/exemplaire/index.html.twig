{% extends 'base.html.twig' %}

{% block title %}Liste des Exemplaires{% endblock %}

{% block body %}
    {% include 'partie/navbar.html.twig' %}

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Document</th>
                <th>État physique</th>
                <th>Statut</th>
                <th>Réservé par</th>
                <th>Date réservation</th>
                <th>Date rendu</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>



            {% for item in exemplairesAvecInfos %}
                {% set exemplaire = item.exemplaire %}
                {% set emprunt = item.emprunt %}
                <tr>
                    <td>{{ exemplaire.idexemplaire }}</td>
                    <td>{{ exemplaire.document.titre }}</td>
                    <td>{{ exemplaire.etatphysique }}</td>
                    <td>{{ exemplaire.statut }}</td>
                    <td>
                        {% if emprunt %}
                            {{ emprunt.utilisateur.nom }} {{ emprunt.utilisateur.prenom }}<br>
                            Réservé le : {{ emprunt.dateReservation|date('d/m/Y') }}<br>
                            Rendu : 
                            {% if emprunt.dateRendu %}
                                {{ emprunt.dateRendu|date('d/m/Y') }}
                            {% else %}
                                Non rendu
                            {% endif %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}


