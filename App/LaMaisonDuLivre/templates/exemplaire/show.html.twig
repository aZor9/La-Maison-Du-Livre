{% extends 'base.html.twig' %}

{% block title %}{{ document.title }}{% endblock %}

{% block body %}
    <h1>{{ document.title }}</h1>
    
    {% if disponible %}
        <span class="badge bg-success">Disponible</span>
        <form action="{{ path('document_reserver', {'id': document.id}) }}" method="post">
            <button type="submit" class="btn btn-primary">Réserver cet exemplaire</button>
        </form>
    {% else %}
        <span class="badge bg-danger">Indisponible</span>
    {% endif %}
{% endblock %}
