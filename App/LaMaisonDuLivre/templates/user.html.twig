{% extends 'base.html.twig' %}

{% block title %}Contenu de la Base de Données{% endblock %}

{% block body %}
    <h1>Contenu complet de la base de données</h1>

    {% for tableName, rows in databaseContent %}
        <h2>Table : {{ tableName }}</h2>

        {% if rows is not empty %}
            <table border="1" cellpadding="5" cellspacing="0">
                <tr>
                    {% for key in rows[0]|keys %}
                        <th>{{ key }}</th>
                    {% endfor %}
                </tr>
                {% for row in rows %}
                    <tr>
                        {% for value in row %}
                            <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <p><em>Aucune donnée dans cette table.</em></p>
        {% endif %}
    {% endfor %}
{% endblock %}
